# Copy to .env (never commit .env)
# Supabase: Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Supabase: Project Settings > Database > Connection string > URI (Session pooler)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Only for `npm run token` (admin login)
ADMIN_EMAIL=admin@kelvorne.test
ADMIN_PASSWORD=your-admin-password
PORT=3000
